{
  "schemaVersion": 1,
  "id": "autotranslate",
  "version": "${version}",
  "name": "Auto Translate CN 自动汉化",
  "description": "内置翻译字典的自动汉化模组：自动扫描 mods 文件夹中所有其他模组并汉化其界面文本（内置 CFPA 模组翻译包，CC BY-NC-SA 4.0）。支持外部词典扩展（config/autotranslate/dict）。",
  "authors": [
    "QWERTYUIOP733"
  ],
  "contact": {},
  "license": "MIT",
  "icon": "assets/autotranslate/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.autotranslate.AutoTranslateMod"
    ],
    "client": [
      "com.autotranslate.client.AutoTranslateModClient"
    ],
    "modmenu": [
      "com.autotranslate.client.ModMenuIntegration"
    ]
  },
  "mixins": [
    "autotranslate.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": "*",
    "cloth-config": ">=26.3.0"
  }
}